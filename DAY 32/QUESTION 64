//Find the digit that occurs the most times in an integer number.

#include <stdio.h>

int main()
{
    int n, digit, i;
    int count[10] = {0};
    int max = 0, result = 0;

    printf("Enter an integer number: ");
    scanf("%d", &n);

    if(n < 0)
    {
        n = -n;
    }

    if(n == 0)
    {
        count[0] = 1;
    }

    // Counting frequency of each digit
    while(n > 0)
    {
        digit = n % 10;
        count[digit]++;
        n = n / 10;
    }

    // Finding the most frequent digit
    for(i = 0; i < 10; i++)
    {
        if(count[i] > max)
        {
            max = count[i];
            result = i;
        }
    }

    printf("Most frequent digit = %d\n", result);
    printf("Number of occurrences = %d\n", max);

    return 0;
}
