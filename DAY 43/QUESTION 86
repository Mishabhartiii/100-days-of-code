//Check if a string is a palindrome.
#include <stdio.h>

int main()
{
    char str[100];
    int i = 0, j, flag = 1;

    printf("Enter a string: ");
    scanf("%s", str);

    // Find the length of string
    while(str[i] != '\0')
    {
        i++;
    }

    j = i - 1;
    i = 0;

    // Check palindrome
    while(i < j)
    {
        if(str[i] != str[j])
        {
            flag = 0;
            break;
        }

        i++;
        j--;
    }

    if(flag == 1)
        printf("String is a Palindrome.");
    else
        printf("String is Not a Palindrome.");

    return 0;
}
