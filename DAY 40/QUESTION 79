//Perform diagonal traversal of a matrix.
#include <stdio.h>

int main()
{
    int a[10][10], r, c, i, j, k;

    printf("Enter number of rows and columns: ");
    scanf("%d %d", &r, &c);

    printf("Enter matrix elements:\n");

    for(i = 0; i < r; i++)
    {
        for(j = 0; j < c; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    printf("Diagonal traversal:\n");

    // Start diagonals from first column
    for(i = 0; i < r; i++)
    {
        j = 0;
        k = i;

        while(k < r && j < c)
        {
            printf("%d ", a[k][j]);
            k++;
            j++;
        }
        printf("\n");
    }

    // Start diagonals from first row
    for(j = 1; j < c; j++)
    {
        i = 0;
        k = j;

        while(i < r && k < c)
        {
            printf("%d ", a[i][k]);
            i++;
            k++;
        }
        printf("\n");
    }

    return 0;
}
