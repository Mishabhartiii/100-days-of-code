#include <stdio.h>

int main() {
    int total_seconds;
    int hours, minutes, seconds;

    printf("Enter time in total seconds: ");
    scanf("%d", &total_seconds);

  
    hours = total_seconds / 3600;         // 1 hour = 3600 seconds
    minutes = (total_seconds % 3600) / 60; // 1 minute = 60 seconds
    seconds = total_seconds % 60;          // Remaining seconds

    printf("\nConverted time is -> %02d:%02d:%02d\n", hours, minutes, seconds);

    return 0;
}
